# Local development example only. Do not commit live secrets or real admin credentials.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=landcheck_local
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/landcheck_local
# Tests default to isolated SQLite. Set this only to a dedicated database whose name contains "test".
LANDCHECK_TEST_DATABASE_URL=sqlite+pysqlite:///:memory:
# Required only for the opt-in Estate PostGIS suite. This must be a disposable database whose
# name includes "test". The runner migrates it to Alembic head before executing integration tests.
LANDCHECK_POSTGIS_TEST_DATABASE_URL=
LANDCHECK_ENV=local
LANDCHECK_API_PUBLIC_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\\.0\\.0\\.1|0\\.0\\.0\\.0|192\\.168\\.\\d{1,3}\\.\\d{1,3}|10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|172\\.(1[6-9]|2\\d|3[0-1])\\.\\d{1,3}\\.\\d{1,3})(:\\d+)?$
MAPBOX_TOKEN=
FLW_SECRET_KEY=
FLW_SECRET_HASH=
R2_GEOREFERENCE_PREFIX=survey/georeference
GEOREFERENCE_DRAFT_RETENTION_DAYS=14
GEOREFERENCE_FINAL_RETENTION_DAYS=45
LANDCHECK_AUTH_SESSION_TTL_HOURS=24
LANDCHECK_AUTH_SESSION_IDLE_MINUTES=240
LANDCHECK_ACTIVITY_LOG_RETENTION_DAYS=365
LANDCHECK_SECURITY_SESSION_RETENTION_DAYS=30
LANDCHECK_ALLOW_LOG_RESET=true
LANDCHECK_REQUIRE_FLW_WEBHOOK_SIGNATURE=false
LANDCHECK_ENV_ADMIN_MFA_ENABLED=false

# LandCheck Estates provisions the organization during company registration. Keep the global
# gate enabled in environments where the Estate web application is deployed.
ESTATES_ENABLED=true
ESTATE_AI_DIGITIZATION=false
ESTATE_SITE_INTELLIGENCE=false
ESTATE_PUBLIC_MAP=false
ESTATE_AI_ASSISTANT=false

# Mobile app update prompt (landcheck-mobile) - keep in sync with app.config.ts `version`
# on every Play Store release, or the in-app "update available" prompt goes stale.
LANDCHECK_LATEST_APP_VERSION=1.0.43
LANDCHECK_MIN_APP_VERSION=1.0.0

SQLALCHEMY_POOL_PRE_PING=true
SQLALCHEMY_POOL_RECYCLE=1800
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_MAX_OVERFLOW=20
SQLALCHEMY_POOL_TIMEOUT=30
SQLALCHEMY_POOL_USE_LIFO=true
REQUEST_ACTIVITY_LOG_ALL=false
REQUEST_ACTIVITY_LOG_SLOW_MS=1500
UVICORN_WORKERS=2
UVICORN_KEEPALIVE=30
WORK_USERNAME=
WORK_PASSWORD=

# LandCheck Survey ("value first, account second") - magic-link + Google sign-in
LANDCHECK_SURVEY_WEB_URL=http://localhost:5173
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/survey/auth/google/callback
# Reuses the same SMTP_* vars other transactional email already uses (SMTP_HOST, SMTP_PORT,
# SMTP_USERNAME, SMTP_PASSWORD, SMTP_FROM_EMAIL, SMTP_FROM_NAME, SMTP_USE_SSL, SMTP_USE_TLS).
