# Production example only. Keep real values only on the server or in a private secret manager.
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
POSTGRES_DB=land_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
LANDCHECK_ENV=production

# Core Estate operations are enabled for this deployment. Keep optional Estate
# intelligence features disabled until their production data services are configured.
ESTATES_ENABLED=true
ESTATE_AI_DIGITIZATION=false
ESTATE_SITE_INTELLIGENCE=false
ESTATE_PUBLIC_MAP=true
ESTATE_AI_ASSISTANT=false

LANDCHECK_API_PUBLIC_URL=https://api.landcheck.online
LANDCHECK_GREEN_URL=https://landcheck.online/green/login
LANDCHECK_WORK_URL=https://landcheck.online/green-work/login

CORS_ALLOW_ORIGINS=https://landcheck.online,https://www.landcheck.online,https://landcheck-web.pages.dev
CORS_ALLOW_ORIGIN_REGEX=

MAPBOX_TOKEN=
GEMINI_API_KEY=
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_JSON_PATH=/app/landcheck-gee-service-account.json

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=
R2_BUCKET=
R2_GEOREFERENCE_PREFIX=survey/georeference
GEOREFERENCE_DRAFT_RETENTION_DAYS=14
GEOREFERENCE_FINAL_RETENTION_DAYS=45

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@landcheck.online
SMTP_FROM_NAME=LandCheck
SMTP_USE_TLS=true
SMTP_USE_SSL=false

FLW_SECRET_KEY=
FLW_SECRET_HASH=
LANDCHECK_AUTH_SESSION_TTL_HOURS=24
LANDCHECK_AUTH_SESSION_IDLE_MINUTES=240
LANDCHECK_ACTIVITY_LOG_RETENTION_DAYS=365
LANDCHECK_SECURITY_SESSION_RETENTION_DAYS=30
LANDCHECK_ALLOW_LOG_RESET=false
LANDCHECK_REQUIRE_FLW_WEBHOOK_SIGNATURE=true
LANDCHECK_ENV_ADMIN_MFA_ENABLED=true

# Mobile app update prompt (landcheck-mobile) - bump LATEST on every Play Store release
# (app.config.ts `version`); MIN only when you need to force-block old installs.
LANDCHECK_LATEST_APP_VERSION=1.0.43
LANDCHECK_MIN_APP_VERSION=1.0.0

SQLALCHEMY_POOL_PRE_PING=true
SQLALCHEMY_POOL_RECYCLE=1800
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_MAX_OVERFLOW=20
SQLALCHEMY_POOL_TIMEOUT=30
SQLALCHEMY_POOL_USE_LIFO=true

REQUEST_ACTIVITY_LOG_ALL=false
REQUEST_ACTIVITY_LOG_SLOW_MS=1500
UVICORN_WORKERS=2
UVICORN_KEEPALIVE=30

WORK_USERNAME=change_me
WORK_PASSWORD=change_me
